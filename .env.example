# Copy to .env.local and fill in. Real values are never committed.

# Neon, from console.neon.tech -> your project -> Connection string (pooled).
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# A second Neon BRANCH of the same project, named `test`. The suite points
# DATABASE_URL at this (tests/setup.ts), so a test can never reach the real one.
TEST_DATABASE_URL=postgresql://user:password@ep-yyy-pooler.region.aws.neon.tech/neondb?sslmode=require

# Google OAuth 2.0 client (Web application), from console.cloud.google.com ->
# APIs & Services -> Credentials. Its Authorized redirect URIs must list every
# origin this app is reached at, each with /auth/callback on the end:
#   http://localhost:3000/auth/callback
#   https://<the-vercel-domain>/auth/callback
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# Signs the session cookie. At least 32 characters; generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out.
SESSION_SECRET=

# Who may sign in. Comma-separated, and in v1 it is one address: Jericho's own
# Google account (#1). An empty value locks everybody out, on purpose.
ALLOWED_EMAILS=

# Cloudflare R2, for the session photos on a meeting record (bst-v1.1 issue 4).
# One PRIVATE bucket, no public URL — the app reads and writes it with an S3 API
# token: Cloudflare dashboard -> R2 -> Manage API tokens, "Object Read &
# Write" on that bucket only. All four or the photos card stays off.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
